<parametername>handle</parametername>
</parameternamelist>
<parameterdescription>
<para>Bus Handle </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>rowName</parametername>
</parameternamelist>
<parameterdescription>
<para>The name of a table row (e.g. &quot;Device.IP.Interface.1&quot;) </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>RBus error code as defined by <ref refid="group___common_1ga8fc1f9c96c061b20db5e56188296c8ef" kindref="member">rbusError_t</ref>. Possible values are: RBUS_ERROR_INVALID_INPUT </para>
</simplesect>
</para>
        </detaileddescription>
