      <memberdef kind="function" id="group__rbus_filter_1ga1617afd172fbb55fe8139b7988342541" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int rbusFilter_Compare</definition>
        <argsstring>(rbusFilter_t filter1, rbusFilter_t filter2)</argsstring>
        <name>rbusFilter_Compare</name>
        <param>
          <type><ref refid="group__rbus_filter_1ga03ad5f80346294826fffde5c271dd22e" kindref="member">rbusFilter_t</ref></type>
          <declname>filter1</declname>
